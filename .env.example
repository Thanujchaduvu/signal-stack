# Pick ONE free LLM provider (leave blank => app tells you to configure one)
# LLM_PROVIDER=gemini | groq | ollama
LLM_PROVIDER=
GEMINI_API_KEY=            # free key: https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=              # free key: https://console.groq.com
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Crawler identity (be a good citizen: put a real contact)
CRAWLER_UA=SignalStackBot/1.0 (+contact: you@example.com)
CRAWL_DELAY_SECONDS=2
DISABLE_SCHEDULER=0
